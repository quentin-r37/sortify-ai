<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FileOrganizer.ViewModels"
             xmlns:avalonia="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:skiaSharpView="clr-namespace:LiveChartsCore.SkiaSharpView;assembly=LiveChartsCore.SkiaSharpView"
             xmlns:converters="clr-namespace:FileOrganizer.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FileOrganizer.UserControls.Step2UserControl" x:DataType="viewModels:Step2ViewModel">

	<UserControl.Resources>
		<converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
    </UserControl.Resources>

	<DockPanel>
		<Border BorderThickness="1,1,1,1" VerticalAlignment="Top" CornerRadius="20"  BorderBrush="{DynamicResource SemiGrey2Color}">
			<ScrollViewer>
				<Border Padding="20">
					<StackPanel>
						<DockPanel Margin="0,0,0,40">
							<Label DockPanel.Dock="Left" VerticalAlignment="Center" Content="Analysis" FontWeight="DemiBold" ></Label>
							<StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
								<Border  Theme="{DynamicResource RadioButtonGroupBorder}">
									<ListBox Theme="{DynamicResource ButtonRadioGroupListBox}">
										<ListBoxItem Classes="Small" IsSelected="{Binding FilterAllFiles, Mode=TwoWay}">All files</ListBoxItem>
										<ListBoxItem Classes="Small" IsSelected="{Binding FilterAllFiles, Mode=TwoWay, Converter={StaticResource InverseBoolConverter}}">Only content files</ListBoxItem>
									</ListBox>
								</Border>
							</StackPanel>
						</DockPanel>

						<Expander DockPanel.Dock="Top" Margin="0,0,0,20">
							<Expander.Header>
								<Label FontWeight="Normal">Size and number of files by month</Label>

							</Expander.Header>
							<avalonia:CartesianChart
								Series="{Binding FilesByMonthSeries}"
								XAxes="{Binding FilesByMonthXAxis}"
								YAxes="{Binding FilesByMonthYAxes}"
								Height="500" LegendPosition="Top"  LegendTextPaint="{Binding LegendTextPaint}" />
						</Expander>
						<Expander DockPanel.Dock="Top" Margin="0,0,0,20" >
							<Expander.Header>
								<Label FontWeight="Normal">Size and number of files by file type</Label>

							</Expander.Header>
							<DockPanel>
								<avalonia:CartesianChart DockPanel.Dock="Top"
									Series="{Binding FilesByTypeSeries}"
									XAxes="{Binding FilesByTypeXAxis}"
									YAxes="{Binding FilesByTypeYAxes}"
                                    LegendPosition="Top" LegendTextPaint="{Binding LegendTextPaint}"
									Height="500" />
								<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,10">
									<TextBlock Text="Number of file types to show:" VerticalAlignment="Center"/>
									<Slider
										Minimum="1"
										Maximum="{Binding MaxFileTypes}"
										Value="{Binding FileTypesCount}"
										Width="200"
										Margin="10,0"/>
									<TextBlock Text="{Binding FileTypesCount}" VerticalAlignment="Center"/>
								</StackPanel>
							</DockPanel>
						</Expander>
						<Expander DockPanel.Dock="Top" Margin="0,0,0,20" >
							<Expander.Header>
								<Label FontWeight="Normal">File list</Label>
							</Expander.Header>
							<DataGrid MaxHeight="500" ItemsSource="{Binding GroupedGridData}" IsScrollInertiaEnabled="True"
									  AutoGenerateColumns="False" IsReadOnly="True"
									  GridLinesVisibility="All"
                                      ScrollViewer.AllowAutoHide="True"
									  CanUserResizeColumns="True"
									  Margin="0,0,0,20" >

								<DataGrid.Columns>
									<DataGridTextColumn x:DataType="viewModels:FileItemViewModel" Header="SubDirectory"  Binding="{Binding DirectoryName}"/>
									<DataGridTextColumn x:DataType="viewModels:FileItemViewModel" Header="Name"  Binding="{Binding Name}"/>
									<DataGridTextColumn x:DataType="viewModels:FileItemViewModel" Header="Created Date" Binding="{Binding CreatedDate}" />
									<DataGridTextColumn x:DataType="viewModels:FileItemViewModel" Header="FileType" Binding="{Binding FileType}" />
									<DataGridTextColumn x:DataType="viewModels:FileItemViewModel" Header="Size" Binding="{Binding Size}" />
								</DataGrid.Columns>
							</DataGrid>
						</Expander>
						<UniformGrid >
							<Button Content="Previous" HorizontalAlignment="Left" Command="{Binding PreviousCommand}" />
							<Button Content="Next" HorizontalAlignment="Right" Command="{Binding NextCommand}" />
						</UniformGrid>
					</StackPanel>
				</Border>

			</ScrollViewer>
		</Border>

	</DockPanel>

</UserControl>
